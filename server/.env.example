# Copy these into your hosting provider's environment variables (Vercel: Project > Settings > Environment Variables).
# Leave them UNSET for local development: the app then uses the file server/lostfound.db.

# Hosted SQLite (Turso). Create a database at https://turso.tech, then:
#   turso db show <name> --url          -> TURSO_DATABASE_URL  (looks like libsql://<name>-<org>.turso.io)
#   turso db tokens create <name>       -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
